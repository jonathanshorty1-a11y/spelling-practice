# Copy this file to .env.local and fill in your own Supabase project values.
# Get these from: https://supabase.com/dashboard/project/_/settings/api
#
# VITE_SUPABASE_URL is your project's API URL (e.g. https://xxxxx.supabase.co)
# VITE_SUPABASE_ANON_KEY is the public "anon" key — safe to expose in a client app,
# it is designed to be used from the browser and is constrained by Row Level Security.
# NEVER put the "service_role" key here or in any frontend code.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: when set, the account whose email matches this address is treated as an
# admin the first time they sign in (see supabase/migrations for the `admins` table).
# You can also add rows to `admins` directly in the Supabase SQL editor.
VITE_ADMIN_BOOTSTRAP_EMAIL=

# If both VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are left empty, the app runs
# entirely in local "guest" mode using localStorage — no backend required. This is
# useful for design/UI work without a Supabase project.
